{
  "name": "@primax/identity-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/identity.prisma && prisma generate --schema prisma/compatibility.prisma",
    "build": "npm run generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "refresh:compatibility": "node scripts/prepare-compatibility.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "nodemailer": "10.2.1",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/express": "5.0.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "5.9.3",
    "prisma": "6.19.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "multer": "2.5.0"
  }
}
