# Template only. Supply real values in hosting settings; never commit populated files.
# Backend Render V2 private variables:
APP_MODE=academic
NODE_ENV=production
DATABASE_PURPOSE=academic-demo
DATABASE_URL=REPLACE_WITH_NEON_V2_POOLED_POSTGRESQL_URL_SSLMODE_REQUIRE
DATABASE_URL_UNPOOLED=REPLACE_WITH_NEON_V2_DIRECT_POSTGRESQL_URL_SSLMODE_REQUIRE
JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET_32_PLUS
KIOSK_API_KEY=REPLACE_WITH_PRIVATE_RANDOM_SECRET_32_PLUS
KIOSK_GATEWAY_SECRET=REPLACE_WITH_PRIVATE_SHARED_GATEWAY_SECRET_32_PLUS
KIOSK_REDIS_REST_URL=https://REPLACE_V2_UPSTASH_HOST.example.invalid
KIOSK_REDIS_REST_TOKEN=REPLACE_WITH_PRIVATE_UPSTASH_V2_TOKEN_32_PLUS
KIOSK_SESSION_NAMESPACE=primax-v2-staging
KIOSK_OPERATOR_USER=REPLACE_WITH_V2_OPERATOR_NAME
KIOSK_OPERATOR_PASSWORD_HASH=REPLACE_WITH_BCRYPT_COST_12_TO_15
KIOSK_STATION_ID=REPLACE_WITH_ACTUAL_V2_STATION_UUID
PAYMENT_ENV=demo
DEMO_WALLET_ENABLED=true
PASSWORD_RESET_DELIVERY=disabled
SHOW_DEMO_ADMIN_CREDENTIALS=false
CORS_ORIGINS=https://REPLACE_FUELFLOW_V2.example.invalid,https://REPLACE_PRIME_V2.example.invalid,https://REPLACE_CONTROL_V2.example.invalid
PLATE_RECOGNITION_ENABLED=true
PLATE_RECOGNITION_URL=https://REPLACE_OCR_V2.example.invalid
OCR_SERVICE_SECRET=REPLACE_WITH_PRIVATE_SHARED_OCR_V2_SECRET_32_PLUS
# Same private OCR_SERVICE_SECRET goes to OCR Render V2.

# Vercel FuelFlow V2 Functions: BACKEND_ORIGIN, FUELFLOW_PUBLIC_ORIGIN,
# KIOSK_GATEWAY_SECRET; build sets FUELFLOW_KIOSK_AUTH=true.
BACKEND_ORIGIN=https://REPLACE_BACKEND_V2.example.invalid
FUELFLOW_PUBLIC_ORIGIN=https://REPLACE_FUELFLOW_V2.example.invalid
FUELFLOW_KIOSK_AUTH=true

# Vercel Control V2 Functions: BACKEND_ORIGIN, PRIMAX_CONTROL_PUBLIC_URL.
# Vercel Control V2 BUILD: exact FuelFlow HTTPS origin, no path or trailing slash.
PRIMAX_CONTROL_PUBLIC_URL=https://REPLACE_CONTROL_V2.example.invalid
PRIMAX_CONTROL_API_URL=/api/v1

# Vercel Prime V2 BUILD: Backend HTTPS /api/v1.
PRIME_API_BASE_URL=https://REPLACE_BACKEND_V2.example.invalid/api/v1
PRIME_PUBLIC_ORIGIN=https://REPLACE_PRIME_V2.example.invalid

# Deployment preflight metadata (not application/public variables):
STAGING_V2_NEON_HOST=REPLACE_WITH_EXACT_NEW_NEON_V2_HOST
STAGING_V2_NEON_PROJECT_ID=REPLACE_WITH_ACTUAL_DISTINCT_PROJECT_ID
