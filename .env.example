# Optional overrides. The local demo starts WITHOUT this file or a .env file.
# Compose contains public LOCAL_DEMO values, suitable only for loopback demo.
# To customize private deployments, generate independent values and keep .env out of Git.
# POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_BYTES
# REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_BYTES
# JWT_SECRET=REPLACE_WITH_RANDOM_HEX_32_BYTES
# KIOSK_API_KEY=REPLACE_WITH_RANDOM_HEX_32_BYTES
# KIOSK_GATEWAY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX_32_BYTES
# OCR_SERVICE_SECRET=REPLACE_WITH_RANDOM_HEX_32_BYTES
# Optional existing station UUID. By default the app resolves PRIMAX-SUR after seed.
# KIOSK_STATION_ID=REPLACE_WITH_LOCAL_STATION_UUID
# KIOSK_OPERATOR_USER=operador
# bcrypt cost 12-15; single quotes preserve dollar signs during Compose interpolation.
# KIOSK_OPERATOR_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'

# Local demo accounts. Set unique local-only passwords (12+ characters).
# DEMO_PASSWORD=REPLACE_WITH_LOCAL_PRIME_DEMO_PASSWORD
# DEMO_CONTROL_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD_16_CHARS_MIN
# DEMO_ENCARGADO_PASSWORD=REPLACE_WITH_LOCAL_ENCARGADO_PASSWORD

# Optional loopback-only ports. PostgreSQL and Redis are not published by default.
FRONTEND1_PORT=26081
FRONTEND2_PORT=26082
FRONTEND3_PORT=26083
BACKEND_PORT=26000
PLATE_RECOGNITION_ENABLED=true
# Internal Compose URL. For staging use a protected HTTPS endpoint or disable OCR temporarily.
PLATE_RECOGNITION_URL=http://plate-recognition:8000
PRIMAX_CONTROL_PUBLIC_URL=http://localhost:26083
# false builds the existing native Windows PrintAgent path instead of simulation.
FUELFLOW_PRINT_DEMO=true
