{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": { "qa/stabilization-v2": false } },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/src/index.html", "permanent": false }],
  "rewrites": [
    { "source": "/api/v1/:route*", "destination": "/api/gateway?route=:route*" }
  ],
  "functions": { "api/gateway.js": { "maxDuration": 60 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "same-origin" },
    { "key": "Cache-Control", "value": "no-store" }
  ] }]
}
